<%-- Encabezado comun: <head>, barra de navegacion segun el perfil y aviso del servidor --%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<%-- Formato numerico argentino (coma decimal) fijo, sin depender del navegador --%>
<fmt:setLocale value="es_AR"/>
<%-- El aviso puede venir de la request (forward) o de la Session (redirect) --%>
<c:set var="avisoTipo" value="${not empty alertaTipo ? alertaTipo : sessionScope.flashTipo}"/>
<c:set var="avisoTexto" value="${not empty alertaTexto ? alertaTexto : sessionScope.flashTexto}"/>
<c:remove var="flashTipo" scope="session"/>
<c:remove var="flashTexto" scope="session"/>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${tituloPagina}"/> - Logística</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="${ctx}/css/app.css" rel="stylesheet">
</head>
<body>
<c:if test="${not empty sessionScope.usuario}">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="${ctx}/inicio">Logística <small>USAL Pilar</small></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                    aria-controls="menu" aria-expanded="false" aria-label="Menú">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    <c:choose>
                        <c:when test="${sessionScope.usuario.esAdmin()}">
                            <li class="nav-item"><a class="nav-link" href="${ctx}/admin/viajes">Viajes</a></li>
                            <li class="nav-item"><a class="nav-link" href="${ctx}/admin/choferes">Choferes</a></li>
                            <li class="nav-item"><a class="nav-link" href="${ctx}/admin/camiones">Camiones</a></li>
                        </c:when>
                        <c:otherwise>
                            <li class="nav-item"><a class="nav-link" href="${ctx}/chofer/viajes">Mis viajes</a></li>
                        </c:otherwise>
                    </c:choose>
                </ul>
                <span class="navbar-text me-3">
                    <c:out value="${sessionScope.usuario.username}"/> (<c:out value="${sessionScope.usuario.rol}"/>)
                </span>
                <%-- Cerrar sesion modifica el estado: va por POST, nunca por un link GET --%>
                <form action="${ctx}/logout" method="post" class="d-flex">
                    <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                </form>
            </div>
        </div>
    </nav>
</c:if>
<main class="container pb-5">
    <%-- fn:escapeXml evita que el texto rompa el atributo HTML (proteccion contra XSS) --%>
    <div id="alerta-servidor" class="alert alert-${avisoTipo eq 'error' ? 'danger' : avisoTipo} d-none"
         data-tipo="${fn:escapeXml(avisoTipo)}" data-texto="${fn:escapeXml(avisoTexto)}" role="alert">
        <c:out value="${avisoTexto}"/>
    </div>
